#version 310 es
#ifdef VULKAN
#extension GL_ARB_shading_language_include : require
#endif

precision highp float;

#ifdef VULKAN
#include "color-transform.frag"
#endif

layout(binding = 0) uniform sampler2D in_tex;
layout(location = 0) in highp vec2 uvpos;
layout(location = 0) out vec4 out_color;

#ifdef VULKAN
layout(push_constant) uniform uniforms { mat4 mvp;
                                         vec2 tex_scale;
                                         vec2 tex_offset;
                                         vec4 margins;
                                         float progress; };
#else
uniform vec4 margins;
uniform float progress;
#endif

// threshold for keycolor
float threshold = 0.65;

// keycolor
vec4 color = vec4(0.0, 0.0, 0.0, 0.7);

void main()
{
    vec4 c = texture(in_tex, uvpos);

#ifdef VULKAN
    c  = vec4(transform_color(c.rgb), c.a);
#endif

    vec4 oc = c;

    vec4 vdiff = abs(vec4(color.rgb, 1.0) - vec4(c.rgb, 1.0));
    float diff = max(max(max(vdiff.r, vdiff.g), vdiff.b), vdiff.a);

    if (diff < threshold)
    {
        oc  *= color.a;
        oc.a = color.a * c.a;
    }

    out_color = mix(c, oc, progress);
}
